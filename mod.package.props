<Project>
  <PropertyGroup>
    <ThunderstoreName>DrakesItemShop</ThunderstoreName>
    <ThunderstoreAuthor>DrakeMods</ThunderstoreAuthor>
    <RootNamespace>DrakesItemShop</RootNamespace>
    <AssemblyName>DrakesItemShop</AssemblyName>
    <Version>0.3.0</Version>
    <BepInPluginName>DrakesItemShop</BepInPluginName>
    <BepInGuid>com.drakesworkshop.itemshop</BepInGuid>
    <ModInfoClass>ItemShopPlugin</ModInfoClass>
    <Description>Armor and weapon racks, display cases, a player trading menu (beta), and mailboxes, drop boxes and PO boxes for RP servers and shops.</Description>
    <WebsiteUrl>https://github.com/drakethos/DrakesItemShop</WebsiteUrl>
  </PropertyGroup>
  <ItemGroup>
    <ThunderstoreDependency Include="denikson-BepInExPack_Valheim-5.4.2351" />
    <ThunderstoreDependency Include="ValheimModding-Jotunn-2.30.2" />
    <ThunderstoreDependency Include="DrakeMods-DrakeModsLibs-1.0.0-beta.2" />
  </ItemGroup>
</Project>
