  <ItemGroup><None Include="App.config" /><None Include="packages.config" /></ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Target Name="CopyNewtonsoftJsonToOutput" AfterTargets="Build">
    <Copy SourceFiles="$(NewtonsoftJsonDll)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('$(NewtonsoftJsonDll)')" />
  </Target>
  <Target Name="EnsureNuGetPackageBuildImports" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('packages\JotunnLib.2.26.1\build\JotunnLib.props')" Text="Restore NuGet packages." />
    <Error Condition="!Exists('packages\Newtonsoft.Json.13.0.3\lib\net45\Newtonsoft.Json.dll')" Text="Restore NuGet packages (Newtonsoft.Json)." />
  </Target>
  <Target Name="PackageMod" AfterTargets="Build;CopyNewtonsoftJsonToOutput" DependsOnTargets="WriteThunderstoreManifest">
    <!-- Gale/r2modman keep folder structure only under plugins/ (patchers/ monomod/ core/ config/): DLL and data live there; manifest.json, icon.png, README.md, CHANGELOG.md stay at the zip root. -->
    <MakeDir Directories="$(ThunderstoreFolder)" />
    <Copy SourceFiles="$(TargetDir)$(TargetFileName)" DestinationFolder="$(ThunderstoreFolder)\plugins" />
    <Copy SourceFiles="$(NewtonsoftJsonDll)" DestinationFolder="$(ThunderstoreFolder)\plugins" Condition="Exists('$(NewtonsoftJsonDll)')" />
    <Copy SourceFiles="$(TargetDir)README.md" DestinationFiles="$(ThunderstoreFolder)\README.md" />
    <Copy SourceFiles="$(TargetDir)icon.png" DestinationFiles="$(ThunderstoreFolder)\icon.png" />
    <Copy SourceFiles="$(TargetDir)CHANGELOG.md" DestinationFiles="$(ThunderstoreFolder)\CHANGELOG.md" />
    <Exec Command="powershell -Command Compress-Archive -Path '$(ThunderstoreFolder)\*' -DestinationPath '$(ZipOutput)' -Force" Condition="'$(CI_SKIP_POST_BUILD)' == ''" />
  </Target>
  <ItemGroup>
    <Content Include="CHANGELOG.md"><CopyToOutputDirectory>Always</CopyToOutputDirectory></Content>
    <Content Include="icon.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="README.md"><CopyToOutputDirectory>Always</CopyToOutputDirectory></Content>
  </ItemGroup>
  <ItemGroup>
    <!-- Display case model (Forge pack in Forge/DisplayCase), inside the DLL so mod managers can't lose it. -->
    <EmbeddedResource Include="DisplayCase\Generated\Assets\**\*.glb" />
    <!-- Item rack models (Forge pack in Forge/ItemRack). -->
    <EmbeddedResource Include="ItemRack\Generated\Assets\**\*.glb" />
    <!-- Mailbox models (Forge pack in Forge/Mailbox). -->
    <EmbeddedResource Include="Mailbox\Generated\Assets\**\*.glb" />
    <EmbeddedResource Include="JuteMat\Generated\Assets\**\*.glb" />
    <!-- Display Card model + RenameIt paper-mesh textures (no RenameIt hard dependency). -->
    <EmbeddedResource Include="DisplayCard\Generated\Assets\**\*.glb" />
    <EmbeddedResource Include="DisplayCard\Generated\Assets\**\*.png" />
    <!-- Open crates (Forge/OpenCrate) — temp purchase stock containers. -->
    <EmbeddedResource Include="OpenCrate\Generated\Assets\**\*.glb" />
    <EmbeddedResource Include="OpenCrate\Generated\Assets\**\*.png" />
    <!-- Storefront: sign, bell and counter models (Forge/Storefront) and the bell / register / sign sounds. -->
    <EmbeddedResource Include="Storefront\Generated\Assets\**\*.glb" />
    <EmbeddedResource Include="Storefront\Sounds\*.wav" />
