{
  "name": "P-03 jute table tray",
  "description": "Picture for the README.",
  "steps": [
    {
      "do": "hook",
      "name": "itemshop.ui.closeAll"
    },
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "spawn",
      "prefab": "Drake_DisplayMat",
      "dz": 3,
      "dx": 0,
      "owner": "Alice",
      "as": "shop"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "itemshop.stock",
      "args": {
        "target": "shop",
        "prefab": "SwordBronze",
        "count": 1,
        "price": "c:40"
      },
      "label": "SwordBronze at c:40",
      "stop": true
    },
    {
      "do": "hook",
      "name": "itemshop.stock",
      "args": {
        "target": "shop",
        "prefab": "AxeBronze",
        "count": 1,
        "price": "c:35"
      },
      "label": "AxeBronze at c:35",
      "stop": true
    },
    {
      "do": "hook",
      "name": "itemshop.stock",
      "args": {
        "target": "shop",
        "prefab": "ShieldBronzeBuckler",
        "count": 1,
        "price": "c:30"
      },
      "label": "ShieldBronzeBuckler at c:30",
      "stop": true
    },
    {
      "do": "hook",
      "name": "itemshop.open",
      "args": {
        "target": "shop",
        "on": true
      },
      "stop": true
    },
    {
      "do": "lookAt",
      "target": "shop",
      "distance": 1.9
    },
    {
      "do": "screenshot",
      "name": "shop-display-mat",
      "clean": true
    },
    {
      "do": "hook",
      "name": "itemshop.ui.closeAll"
    },
    {
      "do": "playAs",
      "who": "me"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesItemShop"
    }
  ]
}