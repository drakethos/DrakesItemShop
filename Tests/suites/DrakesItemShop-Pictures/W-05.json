{
  "name": "W-05 buy window",
  "description": "Picture for the README.",
  "steps": [
    {
      "do": "hook",
      "name": "itemshop.ui.closeAll"
    },
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "spawn",
      "prefab": "Drake_DisplayCase",
      "dz": 3,
      "dx": 0,
      "owner": "Alice",
      "as": "shop"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "itemshop.stock",
      "args": {
        "target": "shop",
        "prefab": "ArrowWood",
        "count": 40,
        "price": "c:3|Wood:2"
      },
      "label": "ArrowWood at c:3|Wood:2",
      "stop": true
    },
    {
      "do": "hook",
      "name": "itemshop.open",
      "args": {
        "target": "shop",
        "on": true
      },
      "stop": true
    },
    {
      "do": "playAs",
      "who": "Bob"
    },
    {
      "do": "give",
      "prefab": "Coins",
      "count": 60
    },
    {
      "do": "hook",
      "name": "itemshop.ui.buy",
      "args": {
        "target": "shop",
        "prefab": "ArrowWood"
      }
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "screenshot",
      "name": "menu-buy-window",
      "clean": false
    },
    {
      "do": "hook",
      "name": "itemshop.ui.closeAll"
    },
    {
      "do": "hook",
      "name": "itemshop.ui.closeAll"
    },
    {
      "do": "playAs",
      "who": "me"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesItemShop"
    }
  ]
}