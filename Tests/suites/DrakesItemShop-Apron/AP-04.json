    {
      "do": "hook",
      "name": "apron.view",
      "args": {
        "yaw": 0,
        "focus": 0.98,
        "dist": 2.0,
        "pitch": 8
      }
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "screenshot",
      "name": "a-before-front"
    },
    {
      "do": "hook",
      "name": "apron.view",
      "args": {
        "yaw": 40,
        "focus": 0.98,
        "dist": 2.0,
        "pitch": 8
      }
