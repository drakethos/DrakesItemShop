{
  "name": "S-11 racks and mats are shops too",
  "description": "",
  "steps": [
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "spawn",
      "prefab": "Drake_WeaponRack",
      "dz": 3,
      "owner": "Alice",
      "as": "shop"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "itemshop.stock",
      "args": {
        "prefab": "SwordBronze",
        "count": 1,
        "price": "c:5",
        "target": "shop"
      },
      "expect": true,
      "label": "stock 1 SwordBronze at c:5",
      "stop": true
    },
    {
      "do": "hook",
      "name": "itemshop.open",
      "args": {
        "target": "shop",
        "on": true
      },
      "expect": true,
      "label": "open for business",
      "stop": true
    },
    {
      "do": "playAs",
      "who": "Bob"
    },
    {
      "do": "give",
      "prefab": "Coins",
      "count": 5
    },
    {
      "do": "hook",
      "name": "itemshop.buy",
      "args": {
        "target": "shop",
        "prefab": "SwordBronze"
      },
      "expect": "",
      "label": "buy from a weapon rack"
    },
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "spawn",
      "prefab": "Drake_DisplayMat",
      "dz": 3,
      "dx": 2.5,
      "owner": "Alice",
      "as": "mat"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "itemshop.stock",
      "args": {
        "target": "mat",
        "prefab": "Club",
        "count": 1,
        "price": "c:2"
      },
      "expect": true,
      "label": "stock a display mat"
    },
    {
      "do": "hook",
      "name": "itemshop.open",
      "args": {
        "target": "mat",
        "on": true
      },
      "expect": true
    },
    {
      "do": "playAs",
      "who": "Bob"
    },
    {
      "do": "give",
      "prefab": "Coins",
      "count": 2
    },
    {
      "do": "hook",
      "name": "itemshop.buy",
      "args": {
        "target": "mat",
        "prefab": "Club"
      },
      "expect": "",
      "label": "buy from the mat"
    },
    {
      "do": "playAs",
      "who": "me"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesItemShop"
    }
  ]
}