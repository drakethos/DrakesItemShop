{
  "name": "S-09 coins are not sold for coins",
  "description": "",
  "steps": [
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "spawn",
      "prefab": "Drake_DisplayCase",
      "dz": 3,
      "owner": "Alice",
      "as": "shop"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "itemshop.stock",
      "args": {
        "prefab": "Coins",
        "count": 50,
        "price": "c:5",
        "target": "shop"
      },
      "expect": true,
      "label": "stock 50 Coins at c:5",
      "stop": true
    },
    {
      "do": "hook",
      "name": "itemshop.open",
      "args": {
        "target": "shop",
        "on": true
      },
      "expect": true,
      "label": "open for business",
      "stop": true
    },
    {
      "do": "playAs",
      "who": "Bob"
    },
    {
      "do": "give",
      "prefab": "Coins",
      "count": 10
    },
    {
      "do": "hook",
      "name": "itemshop.buy",
      "args": {
        "target": "shop",
        "prefab": "Coins"
      },
      "expect": "Coins aren't sold for coins only."
    },
    {
      "do": "playAs",
      "who": "me"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesItemShop"
    }
  ]
}