{
  "name": "S-08 sold out and price changed",
  "description": "",
  "steps": [
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "spawn",
      "prefab": "Drake_DisplayCase",
      "dz": 3,
      "owner": "Alice",
      "as": "shop"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "itemshop.stock",
      "args": {
        "prefab": "SwordBronze",
        "count": 1,
        "price": "c:20",
        "target": "shop"
      },
      "expect": true,
      "label": "stock 1 SwordBronze at c:20",
      "stop": true
    },
    {
      "do": "hook",
      "name": "itemshop.open",
      "args": {
        "target": "shop",
        "on": true
      },
      "expect": true,
      "label": "open for business",
      "stop": true
    },
    {
      "do": "playAs",
      "who": "Bob"
    },
    {
      "do": "give",
      "prefab": "Coins",
      "count": 100
    },
    {
      "do": "hook",
      "name": "itemshop.buy",
      "args": {
        "target": "shop",
        "prefab": "SwordBronze",
        "deals": 2
      },
      "contains": "Sold out",
      "label": "more than in stock"
    },
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "hook",
      "name": "itemshop.setPrice",
      "args": {
        "target": "shop",
        "prefab": "SwordBronze",
        "price": "c:30"
      },
      "expect": true,
      "label": "Alice raises the price"
    },
    {
      "do": "playAs",
      "who": "Bob"
    },
    {
      "do": "hook",
      "name": "itemshop.buy",
      "args": {
        "target": "shop",
        "prefab": "SwordBronze",
        "pay": "c:20"
      },
      "expect": "The price changed. Look again.",
      "label": "buying at the old price is refused"
    },
    {
      "do": "hook",
      "name": "itemshop.buy",
      "args": {
        "target": "shop",
        "prefab": "SwordBronze"
      },
      "expect": "",
      "label": "at the new price it works"
    },
    {
      "do": "check",
      "check": "hasItem",
      "prefab": "Coins",
      "count": 70,
      "label": "paid 30, 70 left"
    },
    {
      "do": "playAs",
      "who": "me"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesItemShop"
    }
  ]
}