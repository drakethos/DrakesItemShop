{
  "name": "S-03 a closed shop does not sell",
  "description": "",
  "steps": [
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "spawn",
      "prefab": "Drake_DisplayCase",
      "dz": 3,
      "owner": "Alice",
      "as": "shop"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "itemshop.stock",
      "args": {
        "prefab": "SwordBronze",
        "count": 1,
        "price": "c:20",
        "target": "shop"
      },
      "expect": true,
      "label": "stock 1 SwordBronze at c:20",
      "stop": true
    },
    {
      "do": "playAs",
      "who": "Bob"
    },
    {
      "do": "give",
      "prefab": "Coins",
      "count": 20
    },
    {
      "do": "hook",
      "name": "itemshop.buy",
      "args": {
        "target": "shop",
        "prefab": "SwordBronze"
      },
      "expect": "The shop is closed."
    },
    {
      "do": "check",
      "check": "hasItem",
      "prefab": "Coins",
      "count": 20,
      "label": "coins kept"
    },
    {
      "do": "playAs",
      "who": "me"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesItemShop"
    }
  ]
}