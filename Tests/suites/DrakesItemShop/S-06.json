{
  "name": "S-06 lots: several items per deal",
  "description": "",
  "steps": [
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "spawn",
      "prefab": "Drake_DisplayCase",
      "dz": 3,
      "owner": "Alice",
      "as": "shop"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "itemshop.stock",
      "args": {
        "prefab": "ArrowWood",
        "count": 20,
        "price": "c:3",
        "target": "shop",
        "lot": 5
      },
      "expect": true,
      "label": "stock 20 ArrowWood at c:3",
      "stop": true
    },
    {
      "do": "hook",
      "name": "itemshop.open",
      "args": {
        "target": "shop",
        "on": true
      },
      "expect": true,
      "label": "open for business",
      "stop": true
    },
    {
      "do": "playAs",
      "who": "Bob"
    },
    {
      "do": "give",
      "prefab": "Coins",
      "count": 6
    },
    {
      "do": "hook",
      "name": "itemshop.buy",
      "args": {
        "target": "shop",
        "prefab": "ArrowWood",
        "deals": 2
      },
      "expect": "",
      "label": "2 deals of 5 arrows"
    },
    {
      "do": "check",
      "check": "hasItem",
      "prefab": "ArrowWood",
      "count": 10,
      "label": "10 arrows"
    },
    {
      "do": "check",
      "check": "noItem",
      "prefab": "Coins",
      "label": "paid 2 x 3 coins"
    },
    {
      "do": "hook",
      "name": "itemshop.stockCount",
      "args": {
        "target": "shop",
        "prefab": "ArrowWood"
      },
      "expect": 10,
      "label": "10 left"
    },
    {
      "do": "playAs",
      "who": "me"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesItemShop"
    }
  ]
}